# Copy to live/.env and fill in YOUR OWN Alpaca PAPER keys. Never commit the real file.
# broker.py hard-refuses to run unless the key starts with "PK" and the endpoint is the paper URL.
ALPACA_API_KEY_ID=PK_your_paper_key_here
ALPACA_API_SECRET_KEY=your_paper_secret_here
ALPACA_PAPER_ENDPOINT=https://paper-api.alpaca.markets
